# Copy to .env and fill in real values before running.
# Never commit .env — it is in .gitignore.

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Supabase (Roast & Resolve project) ──────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service-role key — bypasses RLS

# ── API auth ────────────────────────────────────────────────────────────────
# Shared secret for X-API-Key header. Leave blank to disable (local dev only).
# Generate: openssl rand -hex 32
API_KEY=

# ── Redis ───────────────────────────────────────────────────────────────────
# Strong random password for production Redis.
# Generate: openssl rand -hex 32
REDIS_PASSWORD=changeme-use-openssl-rand

# Base compose uses this directly (no password in dev):
REDIS_URL=redis://redis:6379/0
# Prod compose builds the authenticated URL from REDIS_PASSWORD automatically.

# ── Flower ──────────────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme-use-openssl-rand

# ── Runtime paths ───────────────────────────────────────────────────────────
CHROMIUM_PROFILE_DIR=/data/chromium-profile
OUTPUT_DIR=/data/outputs

# Maximum background video download size in MB (default: 500)
MAX_VIDEO_MB=500

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

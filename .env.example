# Copy to .env and fill in real values before running.
# Never commit .env — it is in .gitignore.

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Postgres (shared qavren-db project, roast_queue lives here) ─────────────
# Transaction-pooler URL; the role's search_path targets the app schema.
DATABASE_URL=postgres://undertow.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── API auth ────────────────────────────────────────────────────────────────
# Shared secret for X-API-Key header. Leave blank to disable (local dev only).
# Generate: openssl rand -hex 32
API_KEY=

# ── Redis ───────────────────────────────────────────────────────────────────
# Strong random password for production Redis.
# Generate: openssl rand -hex 32
REDIS_PASSWORD=changeme-use-openssl-rand

# Base compose uses this directly (no password in dev):
REDIS_URL=redis://redis:6379/0
# Prod compose builds the authenticated URL from REDIS_PASSWORD automatically.

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Get this from: terraform output -raw tunnel_token
# Also add as GitHub secret TUNNEL_TOKEN for the deploy workflow.
TUNNEL_TOKEN=

# ── Flower ──────────────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme-use-openssl-rand

# ── Job reliability: retry + dead-letter ────────────────────────────────────
# Bounded retries for TRANSIENT failures (network / OpenAI 429 / 5xx). Permanent
# failures (malformed input) are dead-lettered immediately, never retried.
JOB_MAX_RETRIES=3
# Exponential backoff: countdown = min(MAX, BASE * 2**retry) seconds, + jitter.
JOB_RETRY_BACKOFF_BASE=30
JOB_RETRY_BACKOFF_MAX=300
# Where exhausted/permanent jobs are captured as JSON ({task_id}.json).
DLQ_DIR=/data/dlq

# ── Completion webhook (optional) ───────────────────────────────────────────
# POSTed on terminal job state (success AND dead_letter). Leave blank to disable
# (no-op). A per-request callback_url on /api/v1/generate overrides this default.
JOB_WEBHOOK_URL=
# If set, the body is HMAC-SHA256 signed: header X-Undertow-Signature=sha256=<hex>.
# Generate: openssl rand -hex 32
JOB_WEBHOOK_SECRET=

# ── OpenAI cost tracking (optional overrides) ───────────────────────────────
# Defaults match list pricing; override only if your negotiated rates differ.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_PRICE_CHAT_INPUT_PER_1M=0.40
# OPENAI_PRICE_CHAT_OUTPUT_PER_1M=1.60
# OPENAI_PRICE_TTS_PER_1M_CHARS=15.0
# OPENAI_PRICE_WHISPER_PER_MIN=0.006

# ── Runtime paths ───────────────────────────────────────────────────────────
CHROMIUM_PROFILE_DIR=/data/chromium-profile
OUTPUT_DIR=/data/outputs

# Maximum background video download size in MB (default: 500)
MAX_VIDEO_MB=500

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

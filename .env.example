# Copy to .env and fill in real values before running.

# Required: OpenAI API key for GPT-4o, TTS, and Whisper
OPENAI_API_KEY=sk-...

# Required in production: shared secret for X-API-Key header auth.
# Leave unset to disable auth (local dev only).
API_KEY=

# Redis connection (default works with docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# Persistent volume paths (mounted via Docker volumes in compose)
CHROMIUM_PROFILE_DIR=/data/chromium-profile
OUTPUT_DIR=/data/outputs

# Maximum background video size in MB (default: 500)
MAX_VIDEO_MB=500

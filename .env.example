# Copy to .env and fill in real values before running.
# Never commit .env — it is in .gitignore.

# ── Required ────────────────────────────────────────────────────────────────

# OpenAI API key (GPT-4o, TTS, Whisper)
OPENAI_API_KEY=sk-...

# Shared secret for X-API-Key header auth (leave blank to disable in local dev)
API_KEY=

# ── Redis ───────────────────────────────────────────────────────────────────

# Strong random password — used by Redis --requirepass and all service URLs.
# Generate: openssl rand -hex 32
REDIS_PASSWORD=changeme-use-openssl-rand

# Base compose uses this directly (no password in dev):
REDIS_URL=redis://redis:6379/0
# Prod compose builds the URL from REDIS_PASSWORD automatically.

# ── Flower ──────────────────────────────────────────────────────────────────

FLOWER_USER=admin
FLOWER_PASSWORD=changeme-use-openssl-rand

# ── TLS / nginx ─────────────────────────────────────────────────────────────

# Your public domain — update nginx/nginx.conf to match
DOMAIN=api.example.com

# ── Runtime paths ───────────────────────────────────────────────────────────

CHROMIUM_PROFILE_DIR=/data/chromium-profile
OUTPUT_DIR=/data/outputs

# Maximum background video download size in MB (default: 500)
MAX_VIDEO_MB=500

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
